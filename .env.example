APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Shopify ───────────────────────────────────────────────────────────
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SCOPES=read_products,read_orders,write_orders,write_themes,read_customers,write_customers
SHOPIFY_API_VERSION=2025-07
# Opcional: URL base pública usada pelo snippet injetado (default = APP_URL)
# SHOPIFY_PUBLIC_API_BASE=https://api.bersenker.shop
# URL do painel (frontend) para onde o callback Shopify redireciona o lojista.
FRONTEND_URL=https://app.bersenker.shop

# ── Unipay (FastSoft Brasil) ───────────────────────────────────────
# Credenciais por loja são armazenadas na tabela `gateways`
# (api_key = pk_live_* pública, secret_key = sk_* secreta).
# Aqui ficam apenas as URLs globais.
UNIPAY_API_URL=https://api.fastsoftbrasil.com
UNIPAY_JS_URL=https://js.fastsoftbrasil.com/security.js

# Meta Graph API (tokens do Pixel ficam criptografados por loja no banco)
META_GRAPH_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v23.0
META_GRAPH_TIMEOUT=8

# TikTok Events API (tokens do Pixel ficam criptografados por loja no banco)
TIKTOK_EVENTS_API_URL=https://business-api.tiktok.com/open_api/v1.3/event/track/
TIKTOK_EVENTS_API_TIMEOUT=8

# Kwai Pixel server-side (opcional; o endpoint é fornecido pelo Kwai para a conta/região)
KWAI_EVENTS_API_URL=
KWAI_EVENTS_API_TIMEOUT=8

# Taboola S2S postback (Account ID and optional URL override are configured per store)
TABOOLA_POSTBACK_URL=https://trc.taboola.com/actions-handler/log/3/s2s-action
TABOOLA_POSTBACK_TIMEOUT=8

# Segurança do webhook: assinatura HMAC (X-Webhook-Signature) e/ou IPs permitidos.
# Deixe ambos vazios apenas em desenvolvimento — em produção configure pelo menos um.
# UNIPAY_WEBHOOK_SECRET=whsec_...
# UNIPAY_WEBHOOK_IPS=1.2.3.4,5.6.7.8

# ── Domínios do projeto ───────────────────────────────────────────────
API_DOMAIN=api.bersenker.shop
ADMIN_DOMAIN=app.bersenker.shop
CHECKOUT_BASE_DOMAIN=bersenker.shop
CHECKOUT_APP_DOMAIN=checkout.bersenker.shop

# ── Cloudflare for SaaS (Custom Hostnames) ──────────────────────────
# Use um API Token restrito a zona e a SSL/Certificates.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_SAAS_CNAME_TARGET=customers.bersenker.shop
CLOUDFLARE_SAAS_FALLBACK_ORIGIN=saas-origin.bersenker.shop
CLOUDFLARE_API_TIMEOUT=10

# ── WhatsApp HTTP API (WAHA - API nao oficial) ──────────────────────
# URL base da instancia WAHA + chave de API (X-Api-Key).
# Cada chip WhatsApp conectado vira uma sessao na WAHA.
WAHA_API_URL=http://localhost:3000
WAHA_API_KEY=
